{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/modavis-project/audio-acoustics-instruments-index/raw/main/schema/github-snapshot.schema.json",
  "title": "GitHub repository metadata snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogue_id",
    "queried_full_name",
    "status",
    "repository_id",
    "node_id",
    "name_with_owner",
    "url",
    "homepage_url",
    "description",
    "is_archived",
    "is_disabled",
    "is_fork",
    "default_branch",
    "primary_language",
    "license_spdx",
    "topics",
    "stargazers_count",
    "forks_count",
    "open_issues_count",
    "created_at",
    "pushed_at",
    "updated_at",
    "captured_at"
  ],
  "properties": {
    "catalogue_id": {"type": "string", "pattern": "^GHIAO-[0-9]{4}$"},
    "queried_full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "status": {"enum": ["available", "unavailable", "merged", "error"]},
    "repository_id": {"type": ["integer", "null"]},
    "node_id": {"type": ["string", "null"]},
    "name_with_owner": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "homepage_url": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "is_archived": {"type": ["boolean", "null"]},
    "is_disabled": {"type": ["boolean", "null"]},
    "is_fork": {"type": ["boolean", "null"]},
    "default_branch": {"type": ["string", "null"]},
    "primary_language": {"type": ["string", "null"]},
    "license_spdx": {"type": ["string", "null"]},
    "topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stargazers_count": {"type": ["integer", "null"], "minimum": 0},
    "forks_count": {"type": ["integer", "null"], "minimum": 0},
    "open_issues_count": {"type": ["integer", "null"], "minimum": 0},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "pushed_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"}
  }
}
